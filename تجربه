    <style>
        /* --- Base Variables and Resets --- */
        :root {
            --bg-color: #1f1f1f;        /* Slightly lighter dark background */
            --card-bg: #2d2d2d;       /* Card background */
            --border-color: #4a4a4a;   /* Softer border */
            --text-color: #e6e6e6;    /* Slightly brighter text */
            --text-muted: #a0a0a0;    /* Muted text/labels */
            --header-color: #ffffff;
            --primary-color: #a78bfa; /* Softer Purple */
            --secondary-color: #2dd4bf; /* Softer Teal */
            --focus-ring-color: rgba(167, 139, 250, 0.5);
            --shadow-color: rgba(0, 0, 0, 0.3);
            --inprogress-color: #facc15; /* Amber/Yellow */
            --finished-color: #737373; /* Neutral Grey */
            --button-hover-bg: #3f3f3f;
            --border-radius-md: 8px;
            --border-radius-lg: 12px;
            --transition-speed: 0.3s;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { font-size: 100%; /* Base font size */ }
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Tajawal', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            line-height: 1.7;
            padding: 1rem;
            min-height: 100vh;
        }
        img, svg { display: block; max-width: 100%; }

        /* --- Layout & Container --- */
        .container {
            max-width: 850px;
            margin: 2rem auto;
            padding: clamp(1.5rem, 5vw, 2.5rem); /* Responsive padding */
            background-color: transparent; /* Let body background show */
        }

        /* --- Typography --- */
        h1, h2, h3 { color: var(--header-color); text-align: center; line-height: 1.3; }
        h1 { font-size: clamp(1.8rem, 5vw, 2.2rem); margin-bottom: 0.5rem; font-weight: 700; }
        h2 { font-size: clamp(1.2rem, 4vw, 1.4rem); color: var(--text-muted); margin-bottom: 2.5rem; font-weight: 500; }
        h3 { font-size: 1.1rem; color: var(--text-muted); margin-bottom: 1.5rem; font-weight: 500; }
        label { font-weight: 500; color: var(--primary-color); }

        /* --- Selection Area --- */
        .selection-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2rem; /* Space between level and department selectors */
            margin-bottom: 2.5rem;
        }
        .selector-group { width: 100%; max-width: 400px; text-align: center; }
        .selector-group label { display: block; margin-bottom: 0.75rem; }

        /* --- Select Dropdown --- */
        .custom-select-wrapper { position: relative; }
        #levelSelect {
            width: 100%; padding: 0.8rem 1.2rem; padding-left: 3rem; /* Space for arrow */
            font-size: 1rem; font-family: inherit; color: var(--text-color);
            background-color: var(--card-bg); border: 1px solid var(--border-color);
            border-radius: var(--border-radius-md); cursor: pointer; appearance: none;
            transition: border-color var(--transition-speed) ease, box-shadow var(--transition-speed) ease;
        }
        .custom-select-wrapper::after { /* Custom Arrow */
            content: ''; border: solid var(--text-muted); border-width: 0 2px 2px 0;
            display: inline-block; padding: 4px; transform: rotate(45deg); -webkit-transform: rotate(45deg);
            position: absolute; left: 1.2rem; top: 50%; transform: translateY(-70%) rotate(45deg); /* Adjust vertical position */
            pointer-events: none; transition: border-color var(--transition-speed) ease;
        }
        #levelSelect:focus {
            outline: none; border-color: var(--primary-color);
            box-shadow: 0 0 0 3px var(--focus-ring-color);
        }
        #levelSelect:hover { border-color: var(--primary-color); }
        .custom-select-wrapper:hover::after { border-color: var(--primary-color); }

        /* --- Department Selector --- */
        #departmentSelectorContainer {
            display: none; width: 100%; background-color: var(--card-bg);
            padding: 1.5rem clamp(1rem, 5vw, 2rem); border-radius: var(--border-radius-lg);
            box-shadow: 0 5px 15px var(--shadow-color);
            opacity: 0; transform: scale(0.98) translateY(10px);
            transition: opacity calc(var(--transition-speed) * 1.2) ease, transform calc(var(--transition-speed) * 1.2) ease;
        }
        #departmentSelectorContainer.visible { display: block; opacity: 1; transform: scale(1) translateY(0); }
        .department-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
        .department-button {
            background-color: var(--bg-color); color: var(--text-color); border: 1px solid var(--border-color);
            padding: 0.7rem 1.4rem; font-size: 0.95rem; font-family: inherit; font-weight: 500;
            border-radius: var(--border-radius-md); cursor: pointer; min-width: 130px; text-align: center;
            transition: all var(--transition-speed) ease;
        }
        .department-button:hover { background-color: var(--button-hover-bg); border-color: var(--primary-color); transform: translateY(-2px); }
        .department-button:focus { outline: none; border-color: var(--primary-color); box-shadow: 0 0 0 3px var(--focus-ring-color); }

        /* --- Schedule Display Area --- */
        #scheduleContainer {
            opacity: 0; transform: translateY(15px);
            transition: opacity calc(var(--transition-speed) * 1.5) ease, transform calc(var(--transition-speed) * 1.5) ease;
        }
        #scheduleContainer.loaded { opacity: 1; transform: translateY(0); }

        /* --- Exam Card Styling --- */
        .exam-card {
            background-color: var(--card-bg); border-radius: var(--border-radius-lg);
            padding: 1.5rem; margin-bottom: 1.5rem;
            box-shadow: 0 4px 12px var(--shadow-color); border-right: 6px solid var(--primary-color);
            transition: transform var(--transition-speed) ease, box-shadow var(--transition-speed) ease;
            overflow: hidden; /* Ensure border radius applies correctly */
        }
        .exam-card:hover { transform: translateY(-4px); box-shadow: 0 8px 16px var(--shadow-color); }
        .exam-detail {
            display: grid; grid-template-columns: auto 1fr; /* Label | Value */
            align-items: baseline; gap: 0.5rem 1rem; /* Row gap | Column gap */
            margin-bottom: 0.8rem; font-size: 0.95rem;
        }
         .exam-detail:last-child { margin-bottom: 0; } /* Remove margin from last detail */
        .exam-detail-label { color: var(--text-muted); font-weight: 500; }
        .exam-detail-value { color: var(--text-color); font-weight: 400; }
        .exam-course .exam-detail-value { font-weight: 700; font-size: 1.1em; color: var(--header-color); }
        .exam-date .exam-detail-value { font-size: 0.9em; }
        .exam-countdown .exam-detail-value { font-weight: 700; color: var(--secondary-color); min-height: 1.6em; }
        .status-inprogress { color: var(--inprogress-color) !important; }
        .status-finished { color: var(--finished-color) !important; font-style: italic; }

        /* --- Message Styling --- */
        #noExamsMessage {
            text-align: center; font-size: 1.05rem; color: var(--text-muted);
            margin-top: 2rem; padding: 2rem 1rem; background-color: var(--card-bg);
            border-radius: var(--border-radius-md); display: none;
            border: 1px dashed var(--border-color);
        }

        /* --- Responsive Adjustments --- */
        @media (max-width: 480px) {
            .exam-detail { grid-template-columns: 1fr; /* Stack label and value on small screens */ gap: 0.2rem; }
            .exam-detail-label::after { content: ':'; margin-right: 0.3rem; } /* Add colon visually */
             h1 { font-size: 1.6rem; } h2 { font-size: 1.1rem; margin-bottom: 2rem; }
             .container { padding: 1rem; }
        }
    </style>
</head>
