        // --- Helper Functions ---
        /** Gets Arabic day name from JS day index (0=Sun) */
        function getArabicDayName(dayIndex) { const days = ["الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"]; return days[dayIndex]; }
        /** Formats Date object to HH:MM AM/PM */
        function formatTime(date) { if (!(date instanceof Date) || isNaN(date)) { return "---"; } return date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }); }
        /** Pluralizes Arabic nouns */
        function pluralizeAr(count, singular, dual, plural3_10, plural11plus) { const absCount = Math.abs(count); if (absCount === 1) return singular; if (absCount === 2) return dual; if (absCount >= 3 && absCount <= 10) return plural3_10; return plural11plus; }
        /** Formats remaining milliseconds into Arabic string */
        function formatRemainingTime(ms) {
             if (ms <= 0) return { status: 'finished', text: '' };
            const totalSeconds = Math.floor(ms / 1000); const totalMinutes = Math.floor(totalSeconds / 60);
            const totalHours = Math.floor(totalMinutes / 60); const days = Math.floor(totalHours / 24);
            const seconds = totalSeconds % 60; const minutes = totalMinutes % 60; const hours = totalHours % 24;
            let parts = [];
            if (days > 0) { parts.push(`${days} ${pluralizeAr(days, 'يوم', 'يومان', 'أيام', 'يوم')}`); }
            if (hours > 0) { parts.push(`${hours} ${pluralizeAr(hours, 'ساعة', 'ساعتان', 'ساعات', 'ساعة')}`); }
            if (minutes > 0) { parts.push(`${minutes} ${pluralizeAr(minutes, 'دقيقة', 'دقيقتان', 'دقائق', 'دقيقة')}`); }
            if (days === 0 && hours === 0 && minutes === 0 && seconds > 0) { parts.push(`${seconds} ${pluralizeAr(seconds, 'ثانية', 'ثانيتان', 'ثواني', 'ثانية')}`); }
            const remainingText = parts.join(' و ');
            if (remainingText === '' && ms > 0) { return { status: 'pending', text: 'لحظات قليلة' }; }
            return { status: 'pending', text: remainingText };
        }
        /** Creates a detail row element */
        function createDetailElement(label, value, detailClass = '', valueClass = '') {
            const detailDiv = document.createElement('div');
            detailDiv.className = `exam-detail ${detailClass}`;
            const labelSpan = document.createElement('span');
            labelSpan.className = 'exam-detail-label';
            labelSpan.textContent = label; // Colon added via CSS for better alignment control
            detailDiv.appendChild(labelSpan);
            const valueSpan = document.createElement('span');
            valueSpan.className = `exam-detail-value ${valueClass}`;
            valueSpan.textContent = value ?? '---'; // Use nullish coalescing
            detailDiv.appendChild(valueSpan);
            return detailDiv;
        }

        // --- Core Logic ---
        /** Clears interval and hides/resets UI elements */
        function resetUI() {
            if (countdownInterval) { clearInterval(countdownInterval); countdownInterval = null; }
            scheduleContainer.innerHTML = ''; // Clear cards
            scheduleContainer.classList.remove('loaded'); // Reset animation state
            departmentSelectorContainer.classList.remove('visible'); // Hide department chooser
            noExamsMessage.style.display = 'none'; // Hide message
        }

        /** Displays the exam schedule based on level and optional department */
        function displaySchedule(selectedLevel, selectedDepartment = null) {
            console.log(`Displaying schedule - Level: ${selectedLevel}, Dept: ${selectedDepartment}`); // Debug
            resetUI(); // Clear previous state first

            const levelValue = /^\d+$/.test(selectedLevel) ? parseInt(selectedLevel, 10) : selectedLevel;

            // Filter exams based on refined logic
            const filteredExams = examData.filter(exam => {
                // Match level first (works for numbers and strings like 'college_elective')
                if (exam.level !== levelValue) return false;

                // Now apply department/common logic based on level type and whether a department was selected
                if (selectedDepartment) { // A specific department was chosen (only applicable for levels >= 4)
                    // Handle the special case for STAT328 at level 6
                    if (exam.course === 'STAT328' && exam.level === 6) {
                        return exam.department === selectedDepartment;
                    }
                    // For other courses in levels 4-10, show if it's specific to the department OR common
                    return exam.department === selectedDepartment || exam.department === 'Common';
                } else { // No department selected OR level doesn't require it
                    const levelNum = parseInt(selectedLevel, 10); // Try parsing level to number

                    if (!isNaN(levelNum) && levelNum >= 1 && levelNum <= 3) { // Levels 1-3: Show only 'Common' courses
                        return exam.department === 'Common';
                    } else if (selectedLevel === 'college_elective') { // College Elective: Show 'Elective' department courses
                        return exam.department === 'Elective';
                    } else if (selectedLevel === 'ce_elective') { // CE Elective: Show 'CE' department courses
                        return exam.department === 'CE';
                    } else if (selectedLevel === 'ee_epe_elective' || selectedLevel === 'ee_ece_elective') { // EE Electives: Show 'EE' department courses
                        return exam.department === 'EE';
                    } else if (selectedLevel === 'me_elective') { // ME Elective: Show 'ME' department courses
                        return exam.department === 'ME';
                    }
                    // Fallback for any case not explicitly handled (e.g., L4-10 selected but department *not* chosen yet)
                    // This case shouldn't technically be reached if UI flow is correct, but safe to return false.
                    return false;
                }
            });
            console.log('Filtered Exams:', filteredExams); // Debug

            // Display message or render cards
            if (filteredExams.length === 0) {
                 let levelText = levelSelect.options[levelSelect.selectedIndex]?.text || selectedLevel;
                 // Find the button text matching the selected department code
                 let deptText = '';
                 if (selectedDepartment) {
                    const deptButton = document.querySelector(`.department-button[data-department="${selectedDepartment}"]`);
                    if (deptButton) {
                        deptText = ` - ${deptButton.textContent}`;
                    }
                 }
                 noExamsMessage.textContent = `لا توجد اختبارات مجدولة لـ ${levelText}${deptText}.`;
                 noExamsMessage.style.display = 'block';
                 requestAnimationFrame(() => scheduleContainer.classList.add('loaded')); // Animate message display
                return;
            }

            // Sort exams by date/time
            try {
                filteredExams.sort((a, b) => {
                    const dateA = new Date(`${a.date}T${a.startTime}`); const dateB = new Date(`${b.date}T${b.startTime}`);
                    if (isNaN(dateA) || isNaN(dateB)) return 0; // Don't crash on invalid dates
                    return dateA - dateB;
                });
            } catch (e) { console.error("Error sorting exams:", e); }

            const now = new Date();
            const fragment = document.createDocumentFragment(); // Use fragment for performance
            const examsToUpdate = []; // Array to hold info for live updates

            // Create and add cards to fragment
            filteredExams.forEach((exam, index) => {
                const card = document.createElement('article'); // More semantic than div
                card.className = 'exam-card';
                let examStartDateTime, examEndDateTime;
                try {
                    examStartDateTime = new Date(`${exam.date}T${exam.startTime}`);
                    examEndDateTime = new Date(`${exam.date}T${exam.endTime}`);
                    if (isNaN(examStartDateTime) || isNaN(examEndDateTime)) throw new Error(`Invalid date/time format for course ${exam.course}`);
                } catch (e) {
                     console.error(e.message, `Data:`, exam);
                     card.innerHTML = `<p style="color: #ff8a8a;">خطأ في تحميل بيانات الاختبار: ${exam.course}<br>يرجى مراجعة مسؤول النظام.</p>`;
                     fragment.appendChild(card);
                     return; // Skip this card
                 }

                const countdownId = `countdown-${selectedLevel}-${selectedDepartment || 'all'}-${index}`; // More specific ID

                card.appendChild(createDetailElement('المقرر', exam.course, 'exam-course'));
                // Format Hijri Date - Use specific locale and calendar
                const hijriDateStr = examStartDateTime.toLocaleDateString('ar-SA-islamic-umalqura', { day: 'numeric', month: 'long', year: 'numeric' });
                // Format Gregorian Date - Use 'en-CA' for YYYY-MM-DD consistently
                const gregorianDateStr = `(${examStartDateTime.toLocaleDateString('en-CA')})`;
                card.appendChild(createDetailElement('التاريخ', `${hijriDateStr} ${gregorianDateStr}`, 'exam-date'));
                card.appendChild(createDetailElement('اليوم', getArabicDayName(examStartDateTime.getDay()), 'exam-day'));
                card.appendChild(createDetailElement('الوقت', `${formatTime(examStartDateTime)} - ${formatTime(examEndDateTime)}`, 'exam-time'));
                const countdownDetail = createDetailElement('الحالة', '', 'exam-countdown');
                // Ensure the value span inside countdownDetail gets the ID
                const countdownValueSpan = countdownDetail.querySelector('.exam-detail-value');
                if (countdownValueSpan) {
                    countdownValueSpan.id = countdownId;
                } else {
                    console.error("Could not find value span for countdown element");
                }
                card.appendChild(countdownDetail);

                fragment.appendChild(card);
                examsToUpdate.push({ id: countdownId, start: examStartDateTime, end: examEndDateTime });

                // Initial update immediately to avoid flicker
                if (countdownValueSpan) {
                    updateSingleCountdown(countdownValueSpan, examStartDateTime, examEndDateTime, now);
                }
            });

            // Append all cards at once and start animation/interval
            scheduleContainer.appendChild(fragment);
            requestAnimationFrame(() => scheduleContainer.classList.add('loaded'));
            startCountdownInterval(examsToUpdate); // Start live updates
        }

        /** Updates a single countdown element's text and style */
        function updateSingleCountdown(valueSpan, examStart, examEnd, now) {
            // Robustness checks
            if (!valueSpan || !(examStart instanceof Date) || isNaN(examStart) || !(examEnd instanceof Date) || isNaN(examEnd)) {
                if(valueSpan) valueSpan.textContent = "خطأ في الوقت";
                return;
            }
            const timeUntilStart = examStart.getTime() - now.getTime();
            const timeUntilEnd = examEnd.getTime() - now.getTime();
            valueSpan.classList.remove('status-inprogress', 'status-finished');
            valueSpan.style.color = ''; // Reset color first

            if (timeUntilStart > 0) { // Exam hasn't started yet
                const remaining = formatRemainingTime(timeUntilStart);
                valueSpan.textContent = remaining.text ? "يبدأ خلال: " + remaining.text : "لحظات قليلة"; // Show something even if formatRemainingTime returns empty for very short durations
                valueSpan.style.color = 'var(--secondary-color)'; // Use secondary color for upcoming
            } else if (timeUntilEnd > 0) { // Exam is currently in progress
                valueSpan.textContent = "الاختبار جاري الآن";
                valueSpan.classList.add('status-inprogress'); // Apply yellow color
            } else { // Exam has finished
                valueSpan.textContent = "الاختبار انتهى";
                valueSpan.classList.add('status-finished'); // Apply grey color and italic
            }
        }

        /** Starts the interval timer to update countdowns */
        function startCountdownInterval(examsToUpdate) {
            if (countdownInterval) clearInterval(countdownInterval); // Clear existing interval first

            countdownInterval = setInterval(() => {
                const currentTime = new Date();
                let allFinished = true; // Assume all are finished until proven otherwise
                if (examsToUpdate.length === 0) { // Optimization: If no exams, clear interval
                     clearInterval(countdownInterval);
                     countdownInterval = null;
                     console.log("No exams to update, stopping interval.");
                     return;
                }

                examsToUpdate.forEach(examInfo => {
                    const valueSpan = document.getElementById(examInfo.id);
                    if (valueSpan) {
                        updateSingleCountdown(valueSpan, examInfo.start, examInfo.end, currentTime);
                        // Check if this exam is still pending or in progress
                        if (examInfo.end.getTime() >= currentTime.getTime()) {
                            allFinished = false; // At least one exam is not finished
                        }
                    } else {
                        // Element might have been removed if user changed level quickly
                        // No need to log warning frequently in production
                        // console.warn("Could not find element for update:", examInfo.id);
                    }
                });
                // If all exams in the *current view* have finished, stop the timer
                if (allFinished && countdownInterval) {
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                     console.log("All exams finished for current view, stopping interval.");
                }
            }, 1000); // Update every second
        }

        // --- Event Listeners ---
        levelSelect.addEventListener('change', (event) => {
            const selectedLevel = event.target.value;
            currentSelectedLevel = selectedLevel; // Store the currently selected level
            resetUI(); // Clear everything first

            if (!selectedLevel) { // No level selected (e.g., "-- اختر المستوى --")
                noExamsMessage.textContent = 'الرجاء اختيار المستوى لعرض جدول الاختبارات.';
                noExamsMessage.style.display = 'block';
                requestAnimationFrame(() => scheduleContainer.classList.add('loaded')); // Animate message in
                return;
            }

            const levelNum = parseInt(selectedLevel, 10);
            // Check if level is between 4 and 10 (inclusive)
            if (!isNaN(levelNum) && levelNum >= 4 && levelNum <= 10) { // Needs department selection
                departmentPrompt.textContent = `اختر القسم للمستوى ${levelSelect.options[levelSelect.selectedIndex].text}:`;
                departmentSelectorContainer.classList.add('visible'); // Show department buttons
                 // Do *not* call displaySchedule here yet
            } else { // L1-3 or Elective - display directly
                displaySchedule(selectedLevel, null); // Pass null for department
            }
        });

        departmentButtons.forEach(button => {
            button.addEventListener('click', () => {
                const selectedDepartment = button.getAttribute('data-department');
                if (currentSelectedLevel && selectedDepartment) { // Ensure a level was previously selected
                    // departmentSelectorContainer.classList.remove('visible'); // Optionally hide selector immediately after click
                    displaySchedule(currentSelectedLevel, selectedDepartment); // Show schedule for the stored level and chosen department
                } else {
                    console.warn("Department button clicked, but no level was selected.");
                    // Optionally provide feedback to the user, though the UI flow should prevent this state.
                }
            });
        });

        // --- Initial State ---
        function initializeApp() {
             console.log("App Initializing");
             // Set the initial message when the page loads
             noExamsMessage.textContent = 'الرجاء اختيار المستوى لعرض جدول الاختبارات.';
             noExamsMessage.style.display = 'block';
             // Trigger the animation for the initial message display
             requestAnimationFrame(() => scheduleContainer.classList.add('loaded'));
        }

        // Wait for the DOM to be fully loaded before running initialization logic
        document.addEventListener('DOMContentLoaded', initializeApp);

